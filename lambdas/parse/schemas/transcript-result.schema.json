{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idp-aws-pipeline.local/schemas/transcript-result.schema.json",
  "title": "Normalized transcript parser result",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "confidence", "warnings", "extracted"],
  "properties": {
    "document_type": {"const": "TRANSCRIPT"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "extracted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_id",
        "student_name",
        "school_name",
        "academic_year",
        "gpa",
        "subjects"
      ],
      "properties": {
        "student_id": {"type": ["string", "null"]},
        "student_name": {"type": ["string", "null"]},
        "school_name": {"type": ["string", "null"]},
        "academic_year": {"type": ["string", "null"]},
        "gpa": {"type": ["number", "null"]},
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name", "credits", "score", "letter_grade", "confidence"],
            "properties": {
              "code": {"type": ["string", "null"]},
              "name": {"type": ["string", "null"]},
              "credits": {"type": ["number", "null"]},
              "score": {"type": ["number", "null"]},
              "letter_grade": {"type": ["string", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": ["code", "field", "message"],
      "properties": {
        "code": {"type": "string"},
        "field": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
