# ==============================================================================
# FILE CẤU HÌNH MẪU CHO TÀI KHOẢN AWS CÁ NHÂN
#
# Hướng dẫn sử dụng:
# 1. Copy file này thành `terraform.tfvars`:
#    cp terraform.tfvars.example terraform.tfvars
# 2. File `terraform.tfvars` đã nằm trong .gitignore nên không bị lộ lên GitHub.
# 3. Điền đúng region và account của bạn trước khi chạy `terraform plan`.
# ==============================================================================

aws_region   = "us-east-1"
project_name = "idp"
environment  = "dev"

# Tài khoản cá nhân: để false để Terraform tự tạo IAM Role cho Lambda,
# Step Functions và Textract.
use_lab_role = false

# Không cần điền khi use_lab_role = false.
lab_role_arn      = ""
workflow_role_arn = ""
textract_role_arn = ""

# Dưới ngưỡng này hoặc có warning thì kết quả được gắn NEEDS_REVIEW.
confidence_threshold = 80

# Giữ log CloudWatch 7 ngày để tiết kiệm chi phí.
log_retention_days = 7
