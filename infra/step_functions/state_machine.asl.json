{
  "Comment": "IDP Pipeline Orchestrator - Điều phối quy trình xử lý hóa đơn / bảng điểm",
  "StartAt": "SetProcessingStatus",
  "States": {
    "SetProcessingStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Comment": "Cập nhật có điều kiện sang PROCESSING và ghi sfn_execution_id để execution này trở thành 'chủ sở hữu' của tài liệu",
      "Parameters": {
        "TableName": "${DOCUMENTS_TABLE_NAME}",
        "Key": {
          "PK": { "S.$": "States.Format('USER#{}', $.user_id)" },
          "SK": { "S.$": "States.Format('DOC#{}', $.document_id)" }
        },
        "UpdateExpression": "SET #status = :processing, updated_at = :now, sfn_execution_id = :exec_id",
        "ConditionExpression": "attribute_exists(PK) AND (#status = :queued OR (#status = :processing AND sfn_execution_id = :exec_id))",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":queued": { "S": "QUEUED" },
          ":processing": { "S": "PROCESSING" },
          ":now": { "S.$": "$$.State.EnteredTime" },
          ":exec_id": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": "$.set_processing_result",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.InternalServerError",
            "DynamoDb.InternalServerError",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDb.RequestLimitExceeded",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDb.ProvisionedThroughputExceededException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException",
            "DynamoDb.ConditionalCheckFailedException"
          ],
          "Comment": "Tài liệu đã ở trạng thái cuối hoặc bản ghi không tồn tại; dừng an toàn, không ghi đè",
          "ResultPath": "$.duplicate_info",
          "Next": "AlreadyProcessedNoOp"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error_info",
          "Next": "HandleFailure"
        }
      ],
      "Next": "RouteByDocumentType"
    },

    "AlreadyProcessedNoOp": {
      "Type": "Pass",
      "Comment": "Bỏ qua an toàn: tài liệu đã ở trạng thái cuối hoặc execution này không còn là chủ sở hữu. Kết thúc thành công, không ghi đè dữ liệu.",
      "Parameters": {
        "notice": "Document already processed, terminal state reached, or ownership lost. No-op termination.",
        "document_id.$": "$.document_id",
        "user_id.$": "$.user_id"
      },
      "Next": "WorkflowSucceeded"
    },

    "RouteByDocumentType": {
      "Type": "Choice",
      "Comment": "Phân nhánh theo loại tài liệu INVOICE hoặc TRANSCRIPT",
      "Choices": [
        {
          "Variable": "$.document_type",
          "StringEquals": "INVOICE",
          "Next": "WaitForTextractInvoiceAnalysis"
        },
        {
          "Variable": "$.document_type",
          "StringEquals": "TRANSCRIPT",
          "Next": "WaitForTextractTranscriptAnalysis"
        }
      ],
      "Default": "HandleInvalidDocumentType"
    },

    "WaitForTextractInvoiceAnalysis": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Comment": "Kích hoạt Textract Expense Analysis qua Lambda StartJob và chờ Task Token callback (timeout 15 phút, không dùng heartbeat vì Textract chạy bất đồng bộ)",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${START_JOB_LAMBDA_ARN}",
        "Payload": {
          "document_id.$": "$.document_id",
          "user_id.$": "$.user_id",
          "document_type.$": "$.document_type",
          "bucket.$": "$.bucket",
          "key.$": "$.key",
          "attempt.$": "$.attempt",
          "task_token.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.ocr_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Textract.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error_info",
          "Next": "HandleFailure"
        }
      ],
      "Next": "EvaluateExtractionResult"
    },

    "WaitForTextractTranscriptAnalysis": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Comment": "Kích hoạt Textract Document Analysis (Tables/Forms) qua Lambda StartJob và chờ Task Token callback (timeout 15 phút)",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${START_JOB_LAMBDA_ARN}",
        "Payload": {
          "document_id.$": "$.document_id",
          "user_id.$": "$.user_id",
          "document_type.$": "$.document_type",
          "bucket.$": "$.bucket",
          "key.$": "$.key",
          "attempt.$": "$.attempt",
          "task_token.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.ocr_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "Textract.ThrottlingException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error_info",
          "Next": "HandleFailure"
        }
      ],
      "Next": "EvaluateExtractionResult"
    },

    "EvaluateExtractionResult": {
      "Type": "Choice",
      "Comment": "Phân loại kết quả trích xuất: SUCCEEDED hoặc NEEDS_REVIEW; kiểm tra đầy đủ các trường bắt buộc để tránh lỗi States.Runtime",
      "Choices": [
        {
          "And": [
            { "Variable": "$.ocr_result.status", "StringEquals": "SUCCEEDED" },
            { "Variable": "$.ocr_result.s3_result_key", "IsPresent": true },
            { "Variable": "$.ocr_result.extracted", "IsPresent": true },
            { "Variable": "$.ocr_result.confidence", "IsPresent": true }
          ],
          "Next": "UpdateStatusSucceeded"
        },
        {
          "And": [
            { "Variable": "$.ocr_result.status", "StringEquals": "NEEDS_REVIEW" },
            { "Variable": "$.ocr_result.s3_result_key", "IsPresent": true },
            { "Variable": "$.ocr_result.extracted", "IsPresent": true },
            { "Variable": "$.ocr_result.warnings", "IsPresent": true },
            { "Variable": "$.ocr_result.confidence", "IsPresent": true }
          ],
          "Next": "UpdateStatusNeedsReview"
        }
      ],
      "Default": "HandleUnexpectedOcrStatus"
    },

    "UpdateStatusSucceeded": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Comment": "Ghi kết quả thành công. Chỉ execution đang sở hữu tài liệu (PROCESSING + đúng sfn_execution_id) mới được ghi.",
      "Parameters": {
        "TableName": "${DOCUMENTS_TABLE_NAME}",
        "Key": {
          "PK": { "S.$": "States.Format('USER#{}', $.user_id)" },
          "SK": { "S.$": "States.Format('DOC#{}', $.document_id)" }
        },
        "UpdateExpression": "SET #status = :succeeded, s3_result_key = :result_key, extracted = :extracted, confidence = :confidence, updated_at = :now",
        "ConditionExpression": "attribute_exists(PK) AND #status = :processing AND sfn_execution_id = :exec_id",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":succeeded": { "S": "SUCCEEDED" },
          ":processing": { "S": "PROCESSING" },
          ":exec_id": { "S.$": "$$.Execution.Id" },
          ":result_key": { "S.$": "$.ocr_result.s3_result_key" },
          ":extracted": { "S.$": "States.JsonToString($.ocr_result.extracted)" },
          ":confidence": { "N.$": "States.Format('{}', $.ocr_result.confidence)" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": "$.db_final_update",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.InternalServerError",
            "DynamoDb.InternalServerError",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDb.RequestLimitExceeded",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDb.ProvisionedThroughputExceededException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException",
            "DynamoDb.ConditionalCheckFailedException"
          ],
          "Comment": "Execution khác đã sở hữu tài liệu hoặc tài liệu đã ở trạng thái cuối; không ghi đè",
          "ResultPath": "$.duplicate_info",
          "Next": "AlreadyProcessedNoOp"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error_info",
          "Next": "HandleFailure"
        }
      ],
      "Next": "SendCompletionNotification"
    },

    "UpdateStatusNeedsReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Comment": "Ghi kết quả cần kiểm tra. Chỉ execution đang sở hữu tài liệu mới được ghi.",
      "Parameters": {
        "TableName": "${DOCUMENTS_TABLE_NAME}",
        "Key": {
          "PK": { "S.$": "States.Format('USER#{}', $.user_id)" },
          "SK": { "S.$": "States.Format('DOC#{}', $.document_id)" }
        },
        "UpdateExpression": "SET #status = :needs_review, s3_result_key = :result_key, extracted = :extracted, warnings = :warnings, confidence = :confidence, updated_at = :now",
        "ConditionExpression": "attribute_exists(PK) AND #status = :processing AND sfn_execution_id = :exec_id",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":needs_review": { "S": "NEEDS_REVIEW" },
          ":processing": { "S": "PROCESSING" },
          ":exec_id": { "S.$": "$$.Execution.Id" },
          ":result_key": { "S.$": "$.ocr_result.s3_result_key" },
          ":extracted": { "S.$": "States.JsonToString($.ocr_result.extracted)" },
          ":warnings": { "S.$": "States.JsonToString($.ocr_result.warnings)" },
          ":confidence": { "N.$": "States.Format('{}', $.ocr_result.confidence)" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": "$.db_final_update",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.InternalServerError",
            "DynamoDb.InternalServerError",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDb.RequestLimitExceeded",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDb.ProvisionedThroughputExceededException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException",
            "DynamoDb.ConditionalCheckFailedException"
          ],
          "Comment": "Execution khác đã sở hữu tài liệu hoặc tài liệu đã ở trạng thái cuối; không ghi đè",
          "ResultPath": "$.duplicate_info",
          "Next": "AlreadyProcessedNoOp"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error_info",
          "Next": "HandleFailure"
        }
      ],
      "Next": "SendCompletionNotification"
    },

    "SendCompletionNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Gửi email thông báo hoàn tất qua Lambda Notification (bọc Catch để lỗi gửi mail không làm sập pipeline)",
      "Parameters": {
        "FunctionName": "${NOTIFICATION_LAMBDA_ARN}",
        "Payload": {
          "document_id.$": "$.document_id",
          "user_id.$": "$.user_id",
          "document_type.$": "$.document_type",
          "file_name.$": "$.file_name",
          "ocr_result.$": "$.ocr_result"
        }
      },
      "ResultPath": "$.notification_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Comment": "Nuốt lỗi gửi mail: Tài liệu đã xử lý thành công thì không được đánh FAILED vì email",
          "ResultPath": "$.notification_error",
          "Next": "WorkflowSucceeded"
        }
      ],
      "Next": "WorkflowSucceeded"
    },

    "WorkflowSucceeded": {
      "Type": "Succeed"
    },

    "HandleInvalidDocumentType": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "INVALID_DOCUMENT_TYPE",
        "message": "Loại tài liệu không được hỗ trợ (chỉ chấp nhận INVOICE hoặc TRANSCRIPT)"
      },
      "ResultPath": "$.error_info",
      "Next": "HandleFailure"
    },

    "HandleUnexpectedOcrStatus": {
      "Type": "Pass",
      "Comment": "Kết quả OCR có status không hợp lệ hoặc thiếu; tạo error_info để HandleFailure ghi nhận được",
      "Parameters": {
        "error_type": "UNEXPECTED_OCR_STATUS",
        "message": "Kết quả OCR trả về status không hợp lệ (chỉ chấp nhận SUCCEEDED hoặc NEEDS_REVIEW)"
      },
      "ResultPath": "$.error_info",
      "Next": "HandleFailure"
    },

    "HandleFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Comment": "Ghi FAILED. Chỉ ghi khi tài liệu chưa ở trạng thái cuối VÀ chưa bị execution khác sở hữu.",
      "Parameters": {
        "TableName": "${DOCUMENTS_TABLE_NAME}",
        "Key": {
          "PK": { "S.$": "States.Format('USER#{}', $.user_id)" },
          "SK": { "S.$": "States.Format('DOC#{}', $.document_id)" }
        },
        "UpdateExpression": "SET #status = :failed, error_reason = :error_reason, updated_at = :now",
        "ConditionExpression": "attribute_exists(PK) AND #status IN (:queued, :processing) AND (attribute_not_exists(sfn_execution_id) OR sfn_execution_id = :exec_id)",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":failed": { "S": "FAILED" },
          ":queued": { "S": "QUEUED" },
          ":processing": { "S": "PROCESSING" },
          ":exec_id": { "S.$": "$$.Execution.Id" },
          ":error_reason": { "S.$": "States.JsonToString($.error_info)" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": "$.db_failure_update",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.InternalServerError",
            "DynamoDb.InternalServerError",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDb.RequestLimitExceeded",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDb.ProvisionedThroughputExceededException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException",
            "DynamoDb.ConditionalCheckFailedException"
          ],
          "Comment": "Bản ghi đã ở trạng thái cuối hoặc thuộc execution khác; chặn ghi đè thành công và KHÔNG gửi mail thất bại",
          "ResultPath": "$.overwrite_prevented",
          "Next": "WorkflowFailed"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.catch_all_failure",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "SendFailureNotification"
    },

    "SendFailureNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Chỉ gửi email báo lỗi khi tài liệu thực sự bị FAILED (nhánh overwrite_prevented đã bỏ qua)",
      "Parameters": {
        "FunctionName": "${NOTIFICATION_LAMBDA_ARN}",
        "Payload": {
          "document_id.$": "$.document_id",
          "user_id.$": "$.user_id",
          "document_type.$": "$.document_type",
          "file_name.$": "$.file_name",
          "status": "FAILED",
          "error_info.$": "$.error_info"
        }
      },
      "ResultPath": "$.notification_result",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notification_error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "WorkflowFailed"
    },

    "WorkflowFailed": {
      "Type": "Fail",
      "Cause": "Pipeline execution failed or timed out",
      "Error": "PipelineExecutionError"
    }
  }
}
